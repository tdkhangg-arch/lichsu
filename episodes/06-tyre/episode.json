      "start": 333,
      "duration": 13,
      "image": "images/shot-13.png",
      "background": "tyresea",
      "camera": "quick push in",
      "characters": [],
      "on_screen_text": null,
      "narration": "The fire ship slammed into the end of the causeway, and both towers went up in flames. Then Tyrian boats rowed out and tore down whatever was left standing.",
      "word_count": 29
    },
    {
      "id": "shot-14",
      "speaker": null,
      "sfx": [
        {
          "type": "thunder",
          "at": 0.05
        },
        {
