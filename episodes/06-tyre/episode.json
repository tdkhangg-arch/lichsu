        },
        {
          "name": "Son",
          "expression": "neutral",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Borrowed some boats?",
      "word_count": 3
    },
    {
      "id": "intro-6",
      "speaker": "father",
      "section": "Intro",
      "start": 42,
      "duration": 10,
      "image": "images/intro-6.png",
      "background": "livingroom",
      "camera": "quick push in",
      "characters": [
