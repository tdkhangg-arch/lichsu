        },
        {
          "name": "Son",
          "expression": "smug",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Never? Maybe his enemies were just weak.",
      "word_count": 7
    },
    {
      "id": "intro-4",
      "speaker": "father",
      "section": "Intro",
      "start": 26,
      "duration": 14,
      "image": "images/intro-4.png",
