          "expression": "smug",
          "pose": "sit"
        },
        {
          "name": "Son",
          "expression": "neutral",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "The opposite. One city was so sure it was untouchable that it laughed at him. It stood on an island, out at sea. No navy, no chance. Guess what Alexander did.",
      "word_count": 31
    },
    {
      "id": "intro-5",
      "speaker": "son",
      "section": "Intro",
      "start": 40,
      "duration": 2,
      "image": "images/intro-5.png",
      "background": "livingroom",
      "camera": "static",
      "characters": [
        {
          "name": "Father",
          "expression": "gentle",
