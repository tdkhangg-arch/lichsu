      ],
      "on_screen_text": "Central Japan, 1560",
      "narration": "June 1560. Central Japan. A huge army is marching west. Twenty-five thousand men, maybe more. Banners, horses and spears as far as the eye can see.",
      "word_count": 26
    },
    {
      "id": "shot-02",
      "section": "Hook",
      "start": 12,
      "duration": 9,
      "image": "images/shot-02.png",
      "background": "valley",
