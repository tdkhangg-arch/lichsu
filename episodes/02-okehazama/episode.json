        {
          "name": "Nobunaga",
          "expression": "determined",
          "pose": "stand"
        }
      ],
      "on_screen_text": null,
      "narration": "Standing in their way is a young lord with a few thousand soldiers, a bad reputation and one very risky idea.",
      "word_count": 21
    },
    {
      "id": "shot-03",
      "section": "Hook",
      "start": 21,
      "duration": 15,
