        }
      ],
      "on_screen_text": null,
      "narration": "Before dawn on the nineteenth day of the fifth month, the border forts of Marune and Washizu came under attack. Smoke was rising over the border, and messengers were riding hard to Nobunaga's castle at Kiyosu.",
      "word_count": 36
    },
    {
