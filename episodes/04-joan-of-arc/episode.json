          "name": "Son",
          "expression": "surprised",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Oh, they did. More than once. And then she went out and reversed a war that grown men had been losing for decades.",
      "word_count": 23
    },
    {
      "id": "intro-5",
      "speaker": "son",
      "section": "Intro",
      "start": 36,
      "duration": 6,
