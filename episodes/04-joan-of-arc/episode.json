        },
        {
          "name": "English knight",
          "expression": "closed",
          "pose": "walk"
        }
      ],
      "on_screen_text": "1453: the war ends",
      "narration": "Joan never lived to see the final victory, but she had lit a fire England couldn't put out. Over the next two decades, the French steadily drove the English out of almost every inch of France. By 1453, the Hundred Years' War was finally over.",
      "word_count": 45
    },
    {
      "id": "shot-39",
      "speaker": null,
      "section": "What came next",
      "start": 609,
      "duration": 12,
      "image": "images/shot-39.png",
      "background": "court",
