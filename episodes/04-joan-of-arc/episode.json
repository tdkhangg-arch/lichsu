        }
      ],
      "on_screen_text": "Patay, 18 June 1429",
      "narration": "Now the French went on the attack. In June, they caught an English army near a village called Patay.",
      "word_count": 19
    },
    {
      "id": "shot-23",
      "speaker": null,
      "section": "The tide turns",
