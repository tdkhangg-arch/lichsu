          "expression": "neutral",
          "pose": "sit"
        }
      ],
      "on_screen_text": "What could she do?",
      "narration": "Her name was Joan. Joan of Arc. But before I tell you her story, answer me this: what could a seventeen-year-old peasant girl possibly do against the most feared army in Europe?",
      "word_count": 32
    },
    {
      "id": "intro-3",
      "speaker": "son",
      "section": "Intro",
      "start": 21,
      "duration": 5,
      "image": "images/intro-3.png",
