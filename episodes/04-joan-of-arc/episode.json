        {
          "name": "Burgundian knight",
          "expression": "angry",
          "pose": "stand"
        }
      ],
      "on_screen_text": "Compiègne, May 1430",
      "narration": "In May 1430, while defending the town of Compiègne, Joan was pulled from her horse and captured by Burgundian soldiers.",
      "word_count": 20
    },
    {
      "id": "shot-30",
      "speaker": null,
      "section": "Captured",
      "start": 390,
      "duration": 13,
