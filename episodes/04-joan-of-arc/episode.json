        },
        {
          "name": "Son",
          "expression": "surprised",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "They did. More than once. And then she turned around a war that grown men had been losing for years.",
      "word_count": 20
    },
    {
      "id": "intro-5",
      "speaker": "son",
      "section": "Intro",
