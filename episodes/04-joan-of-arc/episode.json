        {
          "name": "Son",
          "expression": "determined",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Wait, seventeen? That's one year older than me. Okay, tell me everything.",
      "word_count": 12
    },
    {
      "id": "shot-01",
      "speaker": null,
      "section": "Hook",
      "start": 33,
      "duration": 15,
      "image": "images/shot-01.png",
      "background": "siege",
