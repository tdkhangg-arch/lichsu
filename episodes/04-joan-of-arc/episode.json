        {
          "name": "English knight",
          "expression": "closed",
          "pose": "stand"
        },
        {
          "name": "Townsman",
          "expression": "closed",
          "pose": "stand"
        }
      ],
      "on_screen_text": null,
      "narration": "Witnesses said many in the crowd were in tears, English soldiers among them. One of the English king's own secretaries is said to have walked away saying they had just condemned a saint.",
      "word_count": 33
    },
    {
      "id": "shot-38",
      "speaker": null,
      "section": "What came next",
      "start": 491,
      "duration": 17,
      "image": "images/shot-38.png",
      "background": "parchment",
