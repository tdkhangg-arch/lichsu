          "pose": "walk"
        }
      ],
      "on_screen_text": "11 days through enemy land",
      "narration": "In February 1429, Joan cut her hair short, put on men's clothes, and rode for eleven days through enemy territory with a handful of soldiers.",
      "word_count": 25
    },
    {
      "id": "shot-14",
      "speaker": null,
      "section": "The road to Chinon",
      "start": 209,
      "duration": 16,
