      "background": "court",
      "camera": "slow zoom in",
      "characters": [
        {
          "name": "Joan",
          "expression": "closed",
          "pose": "bow"
        }
      ],
      "on_screen_text": "30 May 1431",
      "narration": "On May 30, 1431, in the old market square of Rouen, Joan was executed. She was just nineteen years old.",
      "word_count": 20
    },
    {
      "id": "shot-37",
      "speaker": null,
      "section": "The darkest day",
