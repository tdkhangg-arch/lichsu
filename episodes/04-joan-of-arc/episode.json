      "image": "images/shot-40.png",
      "background": "cathedral",
      "camera": "slow zoom in",
      "characters": [
        {
          "name": "Joan",
          "expression": "determined",
          "pose": "stand"
        }
      ],
      "on_screen_text": "Saint Joan, 1920",
      "narration": "In 1920, the Catholic Church declared her a saint. Today she is one of the patron saints of France, and statues of Joan on horseback stand in towns all over the country.",
      "word_count": 32
    },
    {
      "id": "shot-41",
      "speaker": null,
