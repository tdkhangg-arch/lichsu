        {
          "name": "French knight",
          "expression": "determined",
          "pose": "walk"
        }
      ],
      "on_screen_text": null,
      "narration": "Joan pushed Charles to do what had seemed impossible: march straight through enemy land to Reims. Town after town opened its gates.",
