        },
        {
          "name": "Son",
          "expression": "smug",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Honestly? Nothing. They'd laugh her right out of the room.",
      "word_count": 10
    },
    {
      "id": "intro-4",
      "speaker": "father",
      "section": "Intro",
      "start": 26,
      "duration": 10,
