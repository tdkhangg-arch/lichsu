        {
          "name": "Son",
          "expression": "smug",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Honestly? Nothing. They'd laugh her out of the room.",
      "word_count": 9
    },
    {
      "id": "intro-4",
      "speaker": "father",
      "section": "Intro",
      "start": 18,
