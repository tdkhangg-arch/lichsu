          "expression": "gentle",
          "pose": "stand"
        }
      ],
      "on_screen_text": "29 April 1429",
      "narration": "Joan reached Orléans at the end of April. People crowded the streets just to see her.",
      "word_count": 16
    },
    {
      "id": "shot-18",
      "speaker": null,
      "section": "Orléans",
      "start": 262,
      "duration": 12,
      "image": "images/shot-18.png",
