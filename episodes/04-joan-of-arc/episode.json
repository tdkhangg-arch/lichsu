      "characters": [
        {
          "name": "Churchman",
          "expression": "gentle",
          "pose": "stand"
        }
      ],
      "on_screen_text": "1456: declared innocent",
      "narration": "Three years later, in 1456, a new church court investigated her trial, exposed the corruption, and declared her completely innocent. Justice had arrived—twenty-five years too late.",
      "word_count": 26
    },
    {
      "id": "shot-40",
      "speaker": null,
      "section": "What came next",
