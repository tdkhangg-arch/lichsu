          "expression": "closed",
          "pose": "stand"
        }
      ],
      "on_screen_text": "Agincourt in reverse",
      "narration": "This time, the English lost thousands of men, and the French lost very few. It was Agincourt in reverse.",
      "word_count": 19
    },
    {
      "id": "shot-25",
      "speaker": null,
      "section": "The crown at Reims",
