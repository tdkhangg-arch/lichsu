        },
        {
          "name": "French knight",
          "expression": "angry",
          "pose": "walk"
        }
      ],
      "on_screen_text": null,
      "narration": "Remember the longbow? This time, the French cavalry charged before the English archers had time to hammer in their stakes. The men who had won Agincourt were swept away.",
      "word_count": 29
    },
    {
      "id": "shot-24",
      "speaker": null,
      "section": "The tide turns",
      "start": 328,
      "duration": 9,
