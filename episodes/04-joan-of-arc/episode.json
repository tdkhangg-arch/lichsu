          "name": "Son",
          "expression": "determined",
          "pose": "sit"
        }
      ],
      "on_screen_text": null,
      "narration": "Wait—seventeen? That's barely older than me! Okay, stop teasing. Tell me everything.",
      "word_count": 12
    },
    {
      "id": "shot-01",
      "speaker": null,
      "section": "Hook",
      "start": 42,
      "duration": 14,
      "image": "images/shot-01.png",
