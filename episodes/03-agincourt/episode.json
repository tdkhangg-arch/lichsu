          "expression": "smug",
          "pose": "stand"
        }
      ],
      "on_screen_text": "Henry V of England",
      "narration": "To understand how they got there, meet Henry the Fifth, King of England. He was twenty-nine years old, serious, deeply religious, and extremely sure of himself.",
      "word_count": 26
    },
    {
      "id": "shot-05",
      "speaker": null,
      "section": "A king with a claim",
      "start": 91,
      "duration": 19,
      "image": "images/shot-05.png",
      "background": "village",
      "camera": "track left",
      "characters": [
        {
