      ],
      "on_screen_text": "Northern France, 1415",
      "narration": "October 1415. Northern France. A small English army is trapped. The men are soaked, starving and sick. Many of them haven't had a proper meal in days.",
      "word_count": 27
    },
    {
      "id": "shot-02",
      "speaker": null,
