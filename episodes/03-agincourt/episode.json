        },
        {
          "name": "French knight",
          "expression": "smug",
          "pose": "stand"
        }
      ],
      "on_screen_text": null,
      "narration": "In front of them, blocking the road home, is the army of France. Knights in shining armor, some of the finest warriors in Europe. And many, many more of them.",
      "word_count": 30
    },
    {
      "id": "shot-03",
      "speaker": null,
      "section": "Hook",
      "start": 65,
      "duration": 14,
      "image": "images/shot-03.png",
      "background": "field",
