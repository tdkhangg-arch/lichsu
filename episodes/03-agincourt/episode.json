      "characters": [
        {
          "name": "Henry V",
          "expression": "determined",
          "pose": "stand"
        }
      ],
      "on_screen_text": null,
      "narration": "By the next evening, one of these armies would be broken, and this battle would become a legend that people in England still talk about, more than six hundred years later.",
      "word_count": 31
    },
    {
      "id": "shot-04",
      "speaker": null,
      "section": "A king with a claim",
      "start": 79,
      "duration": 12,
      "image": "images/shot-04.png",
