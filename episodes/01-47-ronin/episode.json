        {
          "name": "Official",
          "expression": "surprised",
          "pose": "stand"
        }
      ],
      "on_screen_text": null,
      "narration": "Then they turned themselves in to the authorities.",
      "word_count": 8
    },
    {
      "id": "shot-37",
      "section": "The verdict",
      "start": 452,
      "duration": 14,
      "image": "images/shot-37.png",
      "background": "palace",
      "camera": "static",
      "characters": [
        {
          "name": "Official",
          "expression": "angry",
